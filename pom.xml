<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.sampong</groupId>
    <artifactId>mise-tambo</artifactId>
    <version>0.0.4</version>
    <name>mise-tambo</name>
    <description>A Spring CLI application for mise-en-place with TamboUI</description>

    <properties>
        <java.version>25</java.version>
        <tamboui.version>0.5.0</tamboui.version>
        <picocli.version>4.7.7</picocli.version>
        <!-- Pinned to the version tamboui-jline3-backend resolves to, so swapping the uber
             jar for individual modules does not silently change the JLine version. -->
        <jline.version>3.25.1</jline.version>
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <!--
        Version management for the two multi-artifact dependency families this project
        draws on, so no <dependency> below repeats a version:

          * Spring Boot — managed by the spring-boot-dependencies BOM that
            spring-boot-starter-parent (see <parent> above) already imports. The parent
            is deliberately kept rather than swapped for a bare BOM import: it also
            supplies the `native` profile the GraalVM build relies on, plus the
            pluginManagement that versions spring-boot-maven-plugin,
            native-maven-plugin, maven-compiler-plugin and surefire — all of which are
            configured below without a <version> of their own.
          * TamboUI — imported here, since there is no parent to inherit it from.

        Single-artifact dependencies (jspecify, picocli) keep their versions inline;
        there is no BOM to import for them.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.tamboui</groupId>
                <artifactId>tamboui-bom</artifactId>
                <version>${tamboui.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring DI + auto-config, no web server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- TamboUI: fluent Java DSL -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
        </dependency>

        <!-- All three TUI rendering backends are on the classpath; TamboConfig picks one via
             the `tamboui.backend` system property (see TamboConfig#applyBackendPreference),
             defaulting to jline3. The `B` key (Advanced panel) lets the user switch, taking
             effect on the next restart. jline3 is the default: the Panama backend's SIGWINCH
             handling crashes fatally under GraalVM Native Image (see README troubleshooting),
             and fails to start under Windows Git Bash/MinTTY. -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-jline3-backend</artifactId>
            <exclusions>
                <!-- Replaced by the two fine-grained modules below. The backend pulls in
                     org.jline:jline, the uber jar that repackages every JLine module into one
                     artifact - including the jansi, jna and ffm terminal providers this app
                     never selects. It also bundles each module's native-image metadata under
                     its ORIGINAL artifactId (META-INF/native-image/org.jline/jline-terminal-jni/
                     and friends), which no longer matches the containing jar, so native-image
                     warns that the layout is not the recommended groupId/artifactId one. -->
                <exclusion>
                    <groupId>org.jline</groupId>
                    <artifactId>jline</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The only JLine surface JLineBackend touches: org.jline.terminal (Terminal,
             TerminalBuilder, Attributes, Signal) and org.jline.utils (InfoCmp,
             NonBlockingReader). Nothing in this project imports JLine directly. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <!-- jline-terminal on its own only offers the "dumb" fallback terminal; a provider
             implementation has to be on the classpath for TerminalBuilder to hand back a real
             one. JNI is the provider this app wants: it needs no extra dependency beyond the
             jline-native library it pulls in, unlike jna/jansi, and unlike the ffm provider it
             does not depend on the FFM terminal path that the Panama backend notes above
             describe as crash-prone under native image. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jni</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-panama-backend</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-aesh-backend</artifactId>
        </dependency>

        <!-- JSON parsing for `mise ... -J` output -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Nullability annotations (@NullMarked / @Nullable): annotation-only,
             zero transitive deps, read by IDEs and static-analysis tooling. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Command-line parsing for the app's own flags (backend, offline,
             advanced-features): typed options, validation, and generated help/version output,
             in place of hand-rolled ApplicationArguments string matching. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!-- Annotation processor only: generates native-image reflection config for
             TamboCommand's @Option fields at compile time (see maven-compiler-plugin
             below), so picocli's field injection keeps working under GraalVM native-image. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>${picocli.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- TamboUI's picocli integration (TuiMixin's alt-screen/mouse-capture/etc. options,
             TuiCommand base class). -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-picocli</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Scopes picocli-codegen's generated native-image config under this
                         project's own directory (META-INF/native-image/picocli-generated/<groupId>/<artifactId>/)
                         instead of a shared location, avoiding collisions with other picocli
                         users on the classpath. -->
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                        <!-- This app declares no dynamic-proxy interfaces, so picocli-codegen's
                             proxy-config.json comes out empty ("[]") — but native-image still
                             reads it and warns that DynamicProxyConfigurationResources is
                             deprecated. Skip emitting the file rather than shipping an empty one.
                             If dynamic proxies are ever needed, declare them in the reflection
                             section of reachability-metadata.json instead of turning this back on. -->
                        <arg>-Adisable.proxy.config=true</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Maven's own default-test binding sets JUnit-Platform uid-tracking via the
                 deprecated systemProperties element; that config comes from the lifecycle's
                 default bindings, not POM inheritance, so overriding it here only merges
                 alongside the original instead of replacing it. maven.test.skip already
                 means this execution never runs anything, so disable it outright instead
                 of fighting the merge — this drops the warning along with it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- GraalVM native image: build with `mvnw -Pnative native:compile` (the
                 parent's `native` profile binds process-aot and reachability metadata).
                 Requires GraalVM as JAVA_HOME and the MSVC C++ toolchain on Windows.
                 For a profile-guided-optimized build, see the pgo-instrument /
                 pgo-optimize profiles below. -->
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <buildArgs>
                        <!-- Needed regardless of which TUI backend ends up selected at runtime:
                             the Panama backend uses the FFM API directly; JLine's native terminal
                             support loads a bundled JNI library via System.load (a restricted
                             method under the same native-access gate); and this app's own
                             WindowsConsoleMouse (tui/features/) makes raw kernel32 FFM downcalls
                             to disable Windows console QuickEdit mode, independent of either. -->
                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                        <!-- WindowsTerminal (Panama backend) allocates with Arena.ofShared(),
                             which native image only supports when this (experimental) flag is
                             on. Both backends are always on the classpath (see pom dependencies
                             above), so this is needed even when jline3 is the active default. -->
                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                        <buildArg>-H:+SharedArenaSupport</buildArg>
                        <!-- Deliberately omitting the future-defaults flag GraalVM suggests:
                             tried it, and it makes native-image fatally error on this
                             project's fetched reachability-metadata ("Bulk queries can only
                             be set with 'name' which does not allow run-time conditions") —
                             some upstream metadata trips whatever conditional-reflection
                             default it flips on. Revisit on a future GraalVM/plugin bump. -->
                        <!-- Portable baseline CPU target: this binary gets built on one
                             machine and may run on another, so we deliberately do not use
                             -march=native (which ties the binary to the build machine's
                             exact CPU and can crash with an illegal-instruction error
                             elsewhere). -->
                        <buildArg>-march=compatibility</buildArg>
                        <!-- tambo's working set (tool/task/registry lists) is small; a fixed
                             cap gives predictable memory use instead of the GC growing the
                             heap on demand. Bump this if you manage a very large registry. -->
                        <buildArg>-R:MaxHeapSize=128m</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile-guided optimization, step 1: build an instrumented binary that
             records which code paths actually run. Usage:
               mvnw -Pnative,pgo-instrument native:compile
               target/mise-tambo   (use it through a normal session, then quit)
             This writes default.iprof into the project root. -->
        <profile>
            <id>pgo-instrument</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <!-- combine.children="append": Maven's default plugin-config merge
                                 REPLACES the base buildArgs list rather than adding to it, which
                                 would silently drop the base profile's -march/-R:MaxHeapSize flags. -->
                            <buildArgs combine.children="append">
                                <buildArg>--pgo-instrument</buildArg>
                                <buildArg>-R:ProfilesDumpFile=${project.basedir}/default.iprof</buildArg>
                                <!-- Scope instrumentation to our own code: unrestricted
                                     instrumentation also injects counters into the FFM/Panama
                                     upcall stub TamboUI generates for terminal I/O, which
                                     crashes the Graal compiler backend (register-allocator
                                     assertion in the generated stub) if the Panama backend is
                                     the one active when this profile build runs. -->
                                <buildArg>-H:ProfilingPackagePrefixes=com.sampong.tambo</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile-guided optimization, step 2: once default.iprof exists (from
             pgo-instrument above), rebuild the real binary with it applied:
               mvnw -Pnative,pgo-optimize native:compile
             Re-run pgo-instrument and this step again if the workload changes
             enough that the profile goes stale. -->
        <profile>
            <id>pgo-optimize</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <buildArgs combine.children="append">
                                <buildArg>--pgo=${project.basedir}/default.iprof</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
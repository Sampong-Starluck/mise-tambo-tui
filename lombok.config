# Project root: nothing above this directory configures Lombok.
config.stopBubbling = true

# Lombok generates constructors (@RequiredArgsConstructor) but does not carry
# field annotations onto the generated parameters unless they are listed here.
# Without this, a field-level @Qualifier is dropped and injection silently falls
# back to by-type resolution.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
